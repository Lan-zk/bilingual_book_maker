<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram name="EPUB-plan-mode-ladder">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="EPUB plan mode: who decides what text gets translated, and what stops the run&#xa;(book_maker/loader/plan.py, loader/ledger.py, loader/classify/*, loader/epub_loader.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="1. Partition (what text exists)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1700" height="210" as="geometry" />
        </mxCell>
        <mxCell id="css" value="BookCss&#xa;per-document CSS cascade&#xa;(a chapter obeys only the sheets it links)&#xa;&#xa;non-ident class tokens reached through&#xa;escaped selectors become book-global keep-classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="20" y="45" width="380" height="145" as="geometry" />
        </mxCell>
        <mxCell id="part" value="partition_soup() → Unit[]&#xa;every text node becomes a contiguous run a translation fits into&#xa;(a block interrupted by a nested paragraph owns TWO runs)&#xa;each unit keyed by signature = scope + tag + kept classes&#xa;&#xa;overset = a wordless inline atom (formula, URL) stays one atom up to&#xa;400 chars; word-bearing inline keeps the old 40-char barrier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="420" y="45" width="620" height="145" as="geometry" />
        </mxCell>
        <mxCell id="group" value="assign_batches()&#xa;greedy packing of consecutive units to a token budget&#xa;(1200 with the stock prompt, 800 below strict decoding)&#xa;and to GENERAL_GROUP_MAX_UNITS = 16 units&#xa;&#xa;pure function of unit order and text →&#xa;the same book always partitions into the same requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s1">
          <mxGeometry x="1060" y="45" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_css_part" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s1" source="css" target="part">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_part_group" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s1" source="part" target="group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="2. Record the questions (the ledger is a record, not a report)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="1700" height="310" as="geometry" />
        </mxCell>
        <mxCell id="ledger" value="build_ledger()  — one row per signature, built from all_units&#xa;(so a signature this run will SKIP keeps its row, its evidence and its provenance)&#xa;&#xa;row contract:  key · units · chars · pct · mean_chars · samples ·&#xa;               conditional_css · parents · action · decided_by ·&#xa;               content_type · disposition&#xa;&#xa;provenance lives in decided_by alone: &quot;llm&quot; | &quot;agent&quot; | &quot;user&quot; | &quot;all&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="20" y="45" width="660" height="250" as="geometry" />
        </mxCell>
        <mxCell id="samples" value="stride_samples() — up to 5 deduped excerpts spread across ALL&#xa;occurrences, and the LONGEST one always gets a slot&#xa;&#xa;why: a 103-occurrence code signature was once judged on five&#xa;consecutive lines of the same listing; and a strided sample of&#xa;block:article showed only credit lines, so the model skipped 4102&#xa;chars including a 1552-char acknowledgements paragraph no sample had shown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="710" y="45" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="state" value="check_row_state() — two legal states and nothing between:&#xa;  action is null   nobody ruled, and decided_by must be null too&#xa;  action is a verb somebody ruled, so decided_by AND content_type are required&#xa;&#xa;&quot;the name is the reasoning: without it the verdict cannot be audited&quot;&#xa;&#xa;load() refuses: no book_sha256, a sha mismatch, an older schema, a&#xa;duplicate key, a scope that contradicts the key, a missing field" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s2">
          <mxGeometry x="1240" y="45" width="540" height="250" as="geometry" />
        </mxCell>
        <mxCell id="e_ledger_samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s2" source="ledger" target="samples">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_samples_state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s2" source="samples" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="3. Classify — four modes, and deliberately no fifth" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1700" height="290" as="geometry" />
        </mxCell>
        <mxCell id="m_auto" value="--plan-classify auto (default on an epub)&#xa;the translating model rules: over a JSON schema where&#xa;the endpoint verifiably applies one, else over a plain&#xa;conversation answering skip / translate / unsure&#xa;&#xa;unsure and unreadable replies TRANSLATE&#xa;&quot;a skip must not be reached by guessing&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="20" y="45" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m_agent" value="--plan-classify agent&#xa;asks no model: writes the plan with its evidence and prints&#xa;a self-contained instruction block, then stops&#xa;&#xa;exit code 3 — its own code, because 0 would make a caller&#xa;unable to tell a handed-off book from a translated one,&#xa;and a failure code would be the opposite lie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="420" y="45" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m_all" value="--plan-classify all&#xa;translate the whole partition&#xa;&#xa;every row is written as decided_by=&quot;all&quot;,&#xa;content_type=&quot;unclassified&quot; — the difference from a&#xa;silent fallback is that a decision is on record&#xa;&#xa;&quot;the failure this design was built to remove is not that&#xa;everything got translated, it is that something got&#xa;translated and nobody is on record as having decided it&quot;&#xa;&#xa;COUNTEREXAMPLE: that record lives only in memory&#xa;(MODE_POLICY[&quot;all&quot;].writes_plan_file = False): all writes&#xa;no plan JSON, so nothing on disk remembers the choice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="s3">
          <mxGeometry x="820" y="45" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m_none" value="--plan-classify none&#xa;no plan: translate the --translate-tags&#xa;selection, &lt;p&gt; by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="s3">
          <mxGeometry x="1280" y="45" width="500" height="240" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="4. Fail-closed gates before any money is spent" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1700" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gate1" value="empty plan → exit 1&#xa;(a plan that selected nothing is a wrong filter, not a covered book)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="20" y="45" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate2" value="_guard_unsafe_units()&#xa;a unit whose translation cannot be written back&#xa;where it belongs is refused, not translated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="370" y="45" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate3" value="undecided rows → the handoff block, exit 3&#xa;&quot;the greedy all-translate shortcut must not be&#xa;reachable by simply rerunning the command&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="720" y="45" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate4" value="coverage &lt; --plan-min-coverage (0.5) → exit 1&#xa;&quot;refusing to translate a fraction of the&#xa;book silently&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="1070" y="45" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate5" value="require_decided() — the last gate&#xa;nothing undecided, and no decision without&#xa;a decider and a named content type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s4">
          <mxGeometry x="1420" y="45" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate_note" value="each gate is a one-way door: the run exits rather than translating a book nobody decided, and the plan JSON it leaves behind is what the next run (or an agent) resumes on" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="s4">
          <mxGeometry x="20" y="130" width="1660" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="5. Translate grouped requests, then prove the reply still lines up" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1170" width="1700" height="300" as="geometry" />
        </mxCell>
        <mxCell id="align" value="_translate_texts_aligned() — &quot;the one fallback in the system&quot;&#xa;every LLM route returns exactly as many aligned items as it was sent, or raises BatchMismatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="20" y="45" width="1660" height="50" as="geometry" />
        </mxCell>
        <mxCell id="chk1" value="count check&#xa;_check_batch: right count,&#xa;no empty slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="20" y="110" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chk2" value="id check&#xa;echoed ids must be exactly 0..n-1&#xa;(read by id, never by position)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="360" y="110" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chk3" value="same-count shift check 1&#xa;an issued inline marker found in a slot&#xa;that does not own it and gone from the one that does" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="700" y="110" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="chk4" value="same-count shift check 2&#xa;digits: absence is never evidence, one witness is not&#xa;enough, contradictory witnesses are noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="1050" y="110" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ladder" value="a failed check is not an error: say it once, halve the chunk, retry (8+4+2+1+1)&#xa;never re-ask the same group — &quot;a model that miscounted once usually miscounts again&quot;&#xa;from the 3rd recovery the run names the two knobs that shrink a request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="1400" y="110" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e_chk1_ladder" value="wrong count / empty slot → BatchMismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s5" source="chk1" target="ladder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_chk3_ladder" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="s5" source="chk3" target="ladder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_chk4_ladder" value="shift" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#ffffff;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="s5" source="chk4" target="ladder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="parity" value="the plan JSON and the resume cache are kept in step by two fingerprints:&#xa;the plan (book sha256 + overrides + exclude tags + file filters) binds the SLOT ORDER,&#xa;the run (language + prompt + model + pinned glossary) binds a slot's CONTENT —&#xa;&quot;the same paragraph translated into Spanish and into Chinese produces the same job id&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="s5">
          <mxGeometry x="20" y="195" width="1360" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
