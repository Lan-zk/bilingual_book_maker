<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.2.6">
  <diagram name="CLI-resolution-and-refusals">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="bbook_maker: what happens between the typed command and the first paid request&#xa;(book_maker/cli.py, commit e1027a4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lane_in" value="1. Rewrite and parse (no decisions yet)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1700" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legacy" value="legacy_cli.translate_legacy_argv()&#xa;old flags rewritten into the endpoint surface&#xa;(an alias with two readings = hard error, never a guess)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_in">
          <mxGeometry x="20" y="45" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="parser" value="build_parser() / parse_args()&#xa;70 add_argument calls, 74 option strings (72 long)&#xa;9 typed validators reject a bad value at parse time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_in">
          <mxGeometry x="440" y="45" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="normalize_options()&#xa;the ONE place &quot;typed&quot; vs &quot;parser default&quot; is derived&#xa;several flags parse to None so that difference survives" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_in">
          <mxGeometry x="860" y="45" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prov" value="apply_provider()&#xa;--provider is a shorthand for flags:&#xa;every flag actually typed outranks it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_in">
          <mxGeometry x="1300" y="45" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_legacy_parser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_in" source="legacy" target="parser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_parser_norm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_in" source="parser" target="normalize">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_norm_prov" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_in" source="normalize" target="prov">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lane_res" value="2. Resolve (a precedence function per question; the product never asks the operator at run time)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1700" height="230" as="geometry" />
        </mxCell>
        <mxCell id="res_ep" value="resolve_endpoint()&#xa;--model + --model_list together = refuse&#xa;single route name, provider, api_format,&#xa;inferred from host, else from model id&#xa;fills the format's official base + default model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_res">
          <mxGeometry x="20" y="45" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="res_key" value="resolve_api_key()&#xa;--key, legacy env vars, BBM_API_KEY,&#xa;vendor variable, &quot;local&quot; for localhost,&#xa;else exit naming every variable it looked in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_res">
          <mxGeometry x="450" y="45" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="res_mode" value="resolve_context_mode() / resolve_plan_mode() /&#xa;resolve_classify_mode()&#xa;--use_context bare = window, session only when typed;&#xa;plan mode is entered only where the endpoint can decide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_res">
          <mxGeometry x="880" y="45" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="res_probe" value="live capability probe (capabilities.py)&#xa;asks the endpoint, never infers from the model name:&#xa;plain-text prompt + enum-pinned schema, so acceptance&#xa;cannot be mistaken for compliance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_res">
          <mxGeometry x="1310" y="45" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e_res_probe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_res" source="res_mode" target="res_probe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_res_chain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_res" source="res_ep" target="res_key">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_res_chain2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="lane_res" source="res_key" target="res_mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lane_ref" value="3. Refuse and preview (COMPAT_RULES: 51 rows — 10 stop, 41 warn; plus DRY_RUN_RULES: 4)" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="1700" height="380" as="geometry" />
        </mxCell>
        <mxCell id="stop" value="stop rows (10)&#xa;red, exit 1, and ALL warnings are silenced&#xa;— &quot;a warning about a run that is not going&#xa;to happen is noise&quot; (cli.py:1006-1007)&#xa;&#xa;each sentence names: the mechanism, what&#xa;it would cost, and the next keystroke&#xa;e.g. A1: &quot;…the run translates the whole&#xa;book live at full price and then submits an&#xa;empty batch job… Drop the flag.&quot;&#xa;&#xa;the 10 rules share ONE exit site (cli.py:2127)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="lane_ref">
          <mxGeometry x="20" y="45" width="500" height="230" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="warn rows (41)&#xa;yellow, run continues&#xa;— accepted-and-silently-ignored is the defect&#xa;each row's reason is route- or book-type-specific" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="lane_ref">
          <mxGeometry x="550" y="45" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="preview" value="preview layer&#xa;prompt_adoption_line(): which --prompt section went where&#xa;endpoint_preview_lines(): runs the real resolvers, with_key=False&#xa;--plan-dry-run: prints the partition, writes the plan, needs no key&#xa;and DRY_RUN_RULES admit where the preview may differ from the run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="lane_ref">
          <mxGeometry x="940" y="45" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="inline" value="counterexample to &quot;one table, one pass&quot;:&#xa;27 exit/SystemExit sites live in cli.py; the table owns ONE of them (cli.py:2127)&#xa;&#xa;5 capability refusals fire BEFORE check_compatibility():&#xa;--batch on a route without the Batch API,&#xa;--use_context session unsupported, --parallel-workers on codex,&#xa;workers + one session history, workers + no per-chapter context&#xa;&#xa;at least 4 flags are still silently inert off their route, with no rule row:&#xa;--pdf_layout, --interval, --context_paragraph_limit, --temperature&#xa;(the last two were run: zero warnings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;borderStyle=dashed;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="lane_ref">
          <mxGeometry x="550" y="175" width="1130" height="180" as="geometry" />
        </mxCell>

        <mxCell id="lane_out" value="4. Run" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;html=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="loader.make_bilingual_book()&#xa;every sink the run prints to goes through redact(): the endpoint's own words are kept, the run's secrets are removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="lane_out">
          <mxGeometry x="20" y="45" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1470" y="1070" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" value="pure precedence function" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="50" y="28" width="210" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="legend">
          <mxGeometry x="10" y="54" width="30" height="16" as="geometry" />
