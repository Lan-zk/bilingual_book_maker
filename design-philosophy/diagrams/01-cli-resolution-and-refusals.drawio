        <mxCell id="lg2t" value="refusal / counterexample" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="50" y="52" width="210" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="legend">
          <mxGeometry x="10" y="78" width="30" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" value="asked at run time, not from the command" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend">
          <mxGeometry x="50" y="76" width="215" height="20" as="geometry" />
        </mxCell>
      </root>
